generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  admin
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  fullName     String
  dateOfBirth  DateTime @db.Date
  passwordHash String
  role         UserRole @default(customer)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
