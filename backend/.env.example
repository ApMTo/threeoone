NODE_ENV=development
PORT=3001

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

FRONTEND_URL=http://localhost:3000
# COOKIE_DOMAIN=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-smtp-user@gmail.com

# Used by `pnpm prisma:seed` to create a dedicated admin user
ADMIN_EMAIL=admin@three-o-one.local
ADMIN_PASSWORD=Admin123!
ADMIN_FULL_NAME=Store Admin
ADMIN_DATE_OF_BIRTH=1990-01-01

# Stripe (Test mode for local: sk_test_... / whsec_...)
STRIPE_SECRET_KEY=sk_test_replace_me
# 1) pnpm stripe:listen:local
# 2) copy whsec_... from CLI output into this var
# 3) restart backend
# Production: Dashboard → Webhooks → https://API/api/webhooks/stripe
#   events: payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Go-live checklist:
# - Switch to sk_live_ / pk_live_ only with https FRONTEND_URL
# - Create live webhook endpoint pointing at https://API/api/webhooks/stripe
# - Confirm STRIPE_WEBHOOK_SECRET is the live endpoint signing secret
# - Smoke-test one real small payment, then refund in Dashboard
