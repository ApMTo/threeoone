NODE_ENV=development
PORT=3001

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

FRONTEND_URL=http://localhost:3000
# COOKIE_DOMAIN=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-smtp-user@gmail.com

# Used by `pnpm prisma:seed` to create a dedicated admin user
ADMIN_EMAIL=admin@three-o-one.local
ADMIN_PASSWORD=Admin123!
ADMIN_FULL_NAME=Store Admin
ADMIN_DATE_OF_BIRTH=1990-01-01
