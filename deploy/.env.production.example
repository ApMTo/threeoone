# Production env template for Contabo (copy to repo root as `.env` on the server).
# Never commit real secrets.

NODE_ENV=production
PORT=3001

POSTGRES_USER=threeoone
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=threeoone
DATABASE_URL=postgresql://threeoone:change-me-strong-db-password@postgres:5432/threeoone?schema=public

REDIS_HOST=redis
REDIS_PORT=6379

JWT_ACCESS_SECRET=change-me-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

FRONTEND_URL=https://shop.example.com
COOKIE_DOMAIN=.shop.example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@shop.example.com
SMTP_PASS=change-me
SMTP_FROM=noreply@shop.example.com

# Stripe LIVE keys only after Dashboard verification
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_live_replace_me

# Frontend build args
NEXT_PUBLIC_API_URL=https://api.shop.example.com/api
NEXT_PUBLIC_APP_URL=https://shop.example.com
NEXT_PUBLIC_APP_NAME=Three-O-One
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
