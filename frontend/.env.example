# Public frontend variables (safe to expose to the browser)
# Copy to `.env.local` for local development.

NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Three-O-One

# -----------------------------------------------------------------------------
# Server-only secrets must NEVER use the NEXT_PUBLIC_ prefix.
# If you add Next.js Route Handlers / Server Actions that need secrets, put them
# in `.env.local` without NEXT_PUBLIC_ (example below is intentionally commented).
#
# NEST_INTERNAL_API_KEY=
# DATABASE_URL=
# JWT_SECRET=
# -----------------------------------------------------------------------------
